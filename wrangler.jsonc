{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forms-kaliber",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forms_kaliber_db",
      "database_id": "forms_kaliber_db_local",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "forms-kaliber-files"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "LOGIN_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      },
      {
        "name": "SUBMIT_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "UPLOAD_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": {
          "limit": 20,
          "period": 60
        }
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
